{
  "expo": {
    "name": "空白卷",
    "slug": "scanexercise",
    "scheme": "scanexercise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scanexercise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "用來拍攝試卷。",
        "NSPhotoLibraryUsageDescription": "用來選取試卷圖片。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "GIDClientID": "430840613406-tnq189it2aso4uvbhb5vec8tss43js3i.apps.googleusercontent.com",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "scanexercise",
              "com.scanexercise.app",
              "com.googleusercontent.apps.430840613406-tnq189it2aso4uvbhb5vec8tss43js3i"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.scanexercise.app",
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "用來選取試卷圖片。"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.430840613406-tnq189it2aso4uvbhb5vec8tss43js3i"
        }
      ]
    ]
  }
}
